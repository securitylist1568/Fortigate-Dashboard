# ============================================================================
# NTNU Fortigate-Dashboard — Vercel Environment Variables Example
# Copy to .env.local for local testing, or configure in Vercel Project Settings
# NEVER commit actual secrets or tokens to GitHub!
# ============================================================================

# [Required] Security Vault Passkey used for Server-Side AES-256-GCM encryption
# and Client-Side Web Crypto decryption (supports ?auth=<VAULT_PASSKEY> 1-Click link)
VAULT_PASSKEY=your-strong-vault-passkey-here

# [Recommended] Fine-grained read-only GitHub Personal Access Token (no scopes needed for public repo)
# Increases GitHub API rate limit from 60/hr (shared Vercel egress IP) to 5,000/hr
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Optional] Override target GitHub repository (defaults to securitylist1568/Fortigate)
GITHUB_REPO=securitylist1568/Fortigate
